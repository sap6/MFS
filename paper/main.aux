\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Source layout of the cube. (a) Cross-section through the middle of an edge: the lines, seen end on, sit on the bisector plane at the depths $d_j$; base points lie on an inner cube; collocation nodes on the two faces are graded towards the edge. (b) The depths on a logarithmic scale: free lines down to $d_J$, then the tail with fixed weights. (c) The stretched variable $u$ along a line, which clusters the modes towards the two vertices as the depth decreases.}}{17}{figure.4}\protected@file@percent }
\newlabel{fig:cubelayout}{{4}{17}{Source layout of the cube. (a) Cross-section through the middle of an edge: the lines, seen end on, sit on the bisector plane at the depths $d_j$; base points lie on an inner cube; collocation nodes on the two faces are graded towards the edge. (b) The depths on a logarithmic scale: free lines down to $d_J$, then the tail with fixed weights. (c) The stretched variable $u$ along a line, which clusters the modes towards the two vertices as the depth decreases}{figure.4}{}}
